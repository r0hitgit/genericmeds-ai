# Database Configuration (supports SQLite or PostgreSQL)
DATABASE_URL=sqlite:///./genericmeds.db
# For PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/genericmeds

# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Security and Admin Authentication
ADMIN_API_KEY=genericmeds-admin-key-supersecret-change-in-production

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
PRICE_STALE_DAYS=90
